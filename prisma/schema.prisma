// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "core", "audit"]
}

// --- SCHEMA: AUTH ---

model Role {
  id     String  @id  @default(uuid()) @db.Uuid
  name   String @unique @db.VarChar
  status String @default("active") @db.VarChar
  users  User[] 

  @@map("role")
  @@schema("auth")
}

model User {
  id         String   @id  @default(uuid()) @db.Uuid
  dni        String   @unique @db.VarChar(9)
  name       String   @db.VarChar
  lastname   String   @db.VarChar
  rol_id     String   @db.Uuid
  email      String   @unique @db.VarChar
  pass       String   @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)
  status     String    @default("active") @db.VarChar

  role     Role     @relation(fields: [rol_id], references: [id])
  requests  Request[] @relation("userRequests")
  reviews   Request[] @relation("userReviews")
  logs     Log[]

  @@map("users")
  @@schema("auth")
}

// --- SCHEMA: CORE ---

model Carrera {
  id       String    @id @default(uuid()) @db.Uuid
  name     String   @unique @db.VarChar
  status   String   @default("active") @db.VarChar
  requests Request[]

  @@map("carrera")
  @@schema("core")
}

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  status     String   @default("active") @db.VarChar
  typeProcedure   TypeProcedure[]

  @@map("category")
  @@schema("core")
}

model TypeProcedure {
  id           String    @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar
  requirements Json 
  category_id  String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)
  status       String   @default("active") @db.VarChar
  requests     Request[]

  category  Category      @relation(fields: [category_id], references: [id])

  @@map("type_procedure")
  @@schema("core")
}

model Request {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  createByname String   @db.VarChar
  type_id      String   @db.Uuid
  carrera_id   String   @db.Uuid
  observation  String?  @default("Sin observaciones") @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)
  status       String   @default("Enviado") @db.VarChar
  revisor_id   String?  @db.Uuid

  user     User    @relation("userRequests", fields: [user_id], references: [id])
  revisor  User?   @relation("userReviews",fields: [revisor_id], references: [id])
  type_procedure TypeProcedure @relation(fields: [type_id], references: [id])
  carrera   Carrera       @relation(fields: [carrera_id], references: [id])
  documents Document[]
  

  @@map("request")
  @@schema("core")
}

model Document {
  id                String    @id @default(uuid()) @db.Uuid
  request_id        String?   @db.Uuid
  name_requeriments String   @db.VarChar
  name_file         String   @db.VarChar
  router_file       String   @db.VarChar
  size_bytes        BigInt?
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)
  status            String   @db.VarChar

  request Request? @relation(fields: [request_id], references: [id])

  @@map("documents")
  @@schema("core")
}

// --- SCHEMA: AUDIT ---

model Log {
  id           String   @id @default(uuid()) @db.Uuid
  date         DateTime @default(now()) @db.Timestamp(6)
  user_id      String   @db.Uuid
  action       String   @db.VarChar
  resourceType String?  @map("resource_type") @db.VarChar
  resourceId   String?  @map("resource_id") @db.Uuid
  description  String   @db.Text

  user User @relation(fields: [user_id], references: [id])

  @@map("logs")
  @@schema("audit")
}
