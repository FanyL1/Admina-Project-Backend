    "/signup": {
      "post": {
        "summary": "Registrar un nuevo usuario",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "lastname", "dni", "email", "pass"],
                "properties": {
                  "name": { "type": "string" },
                  "lastname": { "type": "string" },
                  "dni": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "pass": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario registrado exitosamente" },
          "400": { "description": "Datos inválidos" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Iniciar sesion",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "pass"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "pass": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login exitoso" },
          "400": { "description": "Datos invalidos" },
          "401": { "description": "Credenciales invalidas" }
        }
      }
    },
